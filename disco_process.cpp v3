void DiscoProtocol::process_task_main()
{
	while(!task_should_exit){
		sem_wait(&process_sem);
		if(task_should_exit) break;
		pthread_mutex_lock(&data_mutex);
		MESSAGE_HEADER *header = (MESSAGE_HEADER*) buffer;
		msg.source_id = header->source_id;
		msg.take_control = header->take_control;
		msg.sequence = header->sequence;
		msg.unix_time_stamp = header->unix_time_stamp;
		msg.utc_microsecond_time_stamp = header->utc_microsecond_time_stamp;
		uint8_t *ptr = &buffer[17];
		int count_index = 0;
		int total_len = header->length;
		void (DiscoProtocol::*process_data)(uint8_t*, uint8_t);
		while(count_index < total_len){
			uint8_t id = ptr[0];
			uint8_t len = ptr[1];
			if(id == 0x02){
				process_data = &DiscoProtocol::process_disco;
				(this->*process_data)(ptr,len);
				//PX4_INFO("%8.4f %8.4f %8.4f %8.4f %8.4f %8.4f %8.4f %8.4f",(double)servo.control[0],(double)servo.control[1],(double)servo.control[2],(double)servo.control[3],(double)servo.control[4],(double)servo.control[5],(double)servo.control[6],(double)servo.control[7]);
			}
			int step = 2 + len;
			count_index += step;
			ptr += step;
		}
		pthread_mutex_unlock(&data_mutex);
	}
	process_task_running = false;
}
