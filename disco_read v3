//----- Header Checksum Function -----//
uint8_t DiscoProtocol::cal_header_check(const uint8_t* pkt){
    const uint8_t* ptr = (const uint8_t*)pkt;
    uint16_t sum = 0;
    for(int i = 0; i < 16; i++){
        sum += ptr[i];
    }
    return (uint8_t)sum;
}

//----- CRC16 Function -----//
uint16_t DiscoProtocol::GetCRC16(const void *buf, unsigned len){
    uint16_t crc;
    const uint8_t *bf;
    bf = (const uint8_t *) buf;
    crc = 0xffff;
    do {
        crc = (crc << 8) ^ crc16tab[((crc >> 8) ^ *bf++) & 0xFF];
    } while (--len);
    return ~crc;
}

//-----open port uart-----//
int DiscoProtocol::open_uart()
{
	fd = open(uart_port, O_RDONLY | O_NOCTTY | O_NONBLOCK);
	if(fd < 0){
		PX4_ERR("Failed to open UART : %s", uart_port);
		return -1;
	}
	//-----setting port uart-----//
	struct termios uart_config;
	tcgetattr(fd, &uart_config);
	cfsetispeed(&uart_config, UART_BAUDRATE);
	cfsetospeed(&uart_config, UART_BAUDRATE);
	uart_config.c_cflag |= (CLOCAL | CREAD);
	uart_config.c_cflag &= ~CSIZE;
	uart_config.c_cflag |= CS8;
	uart_config.c_cflag &= ~PARENB;
	uart_config.c_cflag &= ~CSTOPB;
	uart_config.c_cflag &= ~CRTSCTS;
	tcsetattr(fd, TCSANOW, &uart_config);
	return fd;
}

