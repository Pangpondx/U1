//----- Read Serial UART -----//
void DiscoProtocol::read_serial_task_main()
{
    PX4_INFO("Thread Read Started!!!");
    if(open_uart() < 0){
		PX4_ERR("UART Init Failled");
		read_task_running = false;
		return;
	}
	PX4_INFO("UART Open");
    uint8_t data[MAX_PACKET_SIZE];
    int n = 0;
    void (DiscoProtocol::*state_machine[])(uint8_t, int&) = {&DiscoProtocol::wait_iden,
			    				     &DiscoProtocol::read_header,
			    				     &DiscoProtocol::header_checksum,
			    				     &DiscoProtocol::check_length,
			    				     &DiscoProtocol::read_payload,
			    				     &DiscoProtocol::check_crc16,
			    				     &DiscoProtocol::commit_data};
    //bool byte_processed = false;
    while(!task_should_exit){
	n = read(fd, data, MAX_PACKET_SIZE);
	if(n > 0){
		for(int i = 0; i < n; i++){
			uint8_t byte = data[i];
			(this->*state_machine[static_cast<int>(state)])(byte, i);
		}
	}else{
		px4_usleep(1000);
	}
    }
    read_task_running = false;
}
